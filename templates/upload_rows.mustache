{{!
    @template local_freeaipdfaccessibilityremediation/upload_rows

    Rows of the Upload tab's table.

    Rendered from the dashboard AMD module once the document list has been
    fetched. Every label arrives already translated, so this template chooses
    between values rather than deciding any wording itself.

    Context variables required for this template:
    * rows - the documents on the visible page

    Example context (json):
    {
        "rows": [
            {
                "id": "42",
                "name": "handbook.pdf",
                "selectlabel": "Select handbook.pdf",
                "checked": true,
                "disabled": false,
                "islink": false,
                "source": "file",
                "sourcelabel": "File",
                "sourceurl": "",
                "pages": "12",
                "statuschip": "",
                "statustone": "",
                "canremove": true,
                "removedisabled": false,
                "removelabel": "Remove"
            }
        ]
    }
}}
{{#rows}}
    <tr>
        <td>
            <input type="checkbox" class="aipdf-checkbox" data-aipdf-select="{{id}}"
                aria-label="{{selectlabel}}" {{#checked}}checked{{/checked}} {{#disabled}}disabled{{/disabled}}>
        </td>
        <td>
            <span class="aipdf-doc-cell">
                <span class="aipdf-file-icon {{#islink}}aipdf-file-icon-link{{/islink}}">PDF</span>
                <span>
                    {{name}}
                    {{#sourceurl}}<span class="aipdf-doc-sub">{{sourceurl}}</span>{{/sourceurl}}
                </span>
            </span>
        </td>
        <td class="aipdf-center">
            <span class="aipdf-chip aipdf-chip-{{source}}">{{sourcelabel}}</span>
        </td>
        <td class="aipdf-center">
            {{#statuschip}}<span class="aipdf-chip aipdf-chip-{{statustone}}">{{statuschip}}</span>{{/statuschip}}
            {{^statuschip}}{{pages}}{{/statuschip}}
        </td>
        <td class="aipdf-center">
            <span class="aipdf-row-actions">
                {{#canremove}}
                    <button type="button" class="aipdf-link-danger" data-aipdf-remove="{{id}}"
                        {{#removedisabled}}disabled{{/removedisabled}}>
                        <span data-aipdf-icon="x" data-aipdf-size="14"></span>
                        <span>{{removelabel}}</span>
                    </button>
                {{/canremove}}
            </span>
        </td>
    </tr>
{{/rows}}
