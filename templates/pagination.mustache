{{!
    @template local_freeaipdfaccessibilityremediation/pagination

    Pager beneath each of the workspace's tables.

    The AMD module works out which page numbers to offer and which controls are
    unusable at the current position, so this template only lays them out.

    Context variables required for this template:
    * showing - the "Showing x to y of z" line
    * items - the pager controls, in the order they appear

    Example context (json):
    {
        "showing": "Showing 1 to 10 of 24 records",
        "items": [
            {"symbol": "«", "target": 1, "disabled": true, "current": false, "label": "First page"},
            {"symbol": "1", "target": 1, "disabled": false, "current": true, "label": "Page 1"}
        ]
    }
}}
<span>{{showing}}</span>
<ul class="aipdf-pagination-list">
    {{#items}}
        <li class="{{#current}}aipdf-page-current{{/current}}">
            <button type="button" class="aipdf-page-link" data-aipdf-page="{{target}}"
                aria-label="{{label}}" {{#disabled}}disabled{{/disabled}}>{{symbol}}</button>
        </li>
    {{/items}}
</ul>
