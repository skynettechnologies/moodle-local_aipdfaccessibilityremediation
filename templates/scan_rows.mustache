{{!
    @template local_freeaipdfaccessibilityremediation/scan_rows

    Rows of the Website scan tab's table.

    Rendered from the dashboard AMD module. The status cell is a button only
    while a document is waiting to be scanned, because that is the one state
    an administrator can act on from here.

    Context variables required for this template:
    * rows - the documents on the visible page

    Example context (json):
    {
        "rows": [
            {
                "id": "42",
                "name": "prospectus.pdf",
                "selectlabel": "Select prospectus.pdf",
                "checked": false,
                "disabled": true,
                "sourcelabel": "Source:",
                "sourceurl": "https://example.com/prospectus.pdf",
                "uploadedlabel": "",
                "pages": "24",
                "statuslabel": "Waiting to be scanned",
                "statustone": "pending",
                "statusaction": true
            }
        ]
    }
}}
{{#rows}}
    <tr>
        <td>
            <input type="checkbox" class="aipdf-checkbox" data-aipdf-select="{{id}}"
                aria-label="{{selectlabel}}" {{#checked}}checked{{/checked}} {{#disabled}}disabled{{/disabled}}>
        </td>
        <td>
            <span class="aipdf-doc-cell">
                <span class="aipdf-file-icon">PDF</span>
                <span>
                    {{name}}
                    <span class="aipdf-doc-sub">
                        {{sourcelabel}}
                        {{#sourceurl}}
                            <a href="{{sourceurl}}" target="_blank" rel="noreferrer noopener">{{sourceurl}}</a>
                        {{/sourceurl}}
                        {{^sourceurl}}{{uploadedlabel}}{{/sourceurl}}
                    </span>
                </span>
            </span>
        </td>
        <td class="aipdf-center">{{pages}}</td>
        <td class="aipdf-center">
            {{#statusaction}}
                <button type="button" class="aipdf-chip aipdf-chip-{{statustone}} aipdf-chip-button"
                    data-aipdf-scan="{{id}}">{{statuslabel}}</button>
            {{/statusaction}}
            {{^statusaction}}
                <span class="aipdf-chip aipdf-chip-{{statustone}}">{{statuslabel}}</span>
            {{/statusaction}}
        </td>
    </tr>
{{/rows}}
