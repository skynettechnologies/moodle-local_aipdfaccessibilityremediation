{{!
    @template local_freeaipdfaccessibilityremediation/remediated_rows

    Rows of the Remediated PDFs tab's table.

    Rendered from the dashboard AMD module. The download button carries the
    file name as well as the id, because the file is fetched with the session
    token attached and handed to the browser rather than linked to directly.

    Context variables required for this template:
    * rows - the documents on the visible page

    Example context (json):
    {
        "rows": [
            {
                "id": "42",
                "name": "handbook-remediated.pdf",
                "source": "file",
                "sourcelabel": "Upload",
                "date": "3 Sep 2026",
                "pages": "12",
                "downloadlabel": "Download"
            }
        ]
    }
}}
{{#rows}}
    <tr>
        <td>
            <span class="aipdf-doc-cell">
                <span class="aipdf-file-icon aipdf-file-icon-purple">PDF</span>
                {{name}}
            </span>
        </td>
        <td class="aipdf-center">
            <span class="aipdf-chip aipdf-chip-{{source}}">{{sourcelabel}}</span>
        </td>
        <td class="aipdf-center">{{date}}</td>
        <td class="aipdf-center">{{pages}}</td>
        <td class="aipdf-right">
            <span class="aipdf-table-actions">
                <button type="button" class="aipdf-btn aipdf-btn-outline aipdf-btn-sm"
                    data-aipdf-download="{{id}}" data-aipdf-name="{{name}}">
                    <span data-aipdf-icon="download" data-aipdf-size="16"></span>
                    <span>{{downloadlabel}}</span>
                </button>
            </span>
        </td>
    </tr>
{{/rows}}
